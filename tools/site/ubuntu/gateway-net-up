#!/bin/sh
# The gateway's host side: tap0 for the machines, and NAT to the Internet.
# Run by plan9-gateway.service before tools/gateway opens the tap.
set -e

uplink=${UPLINK:-$(ip route show default | awk '{print $5; exit}')}
test -n "$uplink" || { echo "gateway-net-up: no default route" >&2; exit 1; }

ip link show tap0 >/dev/null 2>&1 || ip tuntap add dev tap0 mode tap
ip addr replace 10.0.2.2/24 dev tap0
ip link set tap0 up
sysctl -qw net.ipv4.ip_forward=1
sysctl -qw net.ipv4.conf.tap0.rp_filter=2
sysctl -qw net.ipv4.conf.all.rp_filter=2

iptables -t nat -C POSTROUTING -s 10.0.2.0/24 -o "$uplink" -j MASQUERADE 2>/dev/null ||
	iptables -t nat -A POSTROUTING -s 10.0.2.0/24 -o "$uplink" -j MASQUERADE
# ahead of any catch-all REJECT an image's firewall may have (Oracle's does)
while iptables -D FORWARD -i tap0 -o "$uplink" -j ACCEPT 2>/dev/null; do :; done
while iptables -D FORWARD -i "$uplink" -o tap0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; do :; done
iptables -I FORWARD 1 -i tap0 -o "$uplink" -j ACCEPT
iptables -I FORWARD 1 -i "$uplink" -o tap0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

echo "gateway-net-up: tap0 10.0.2.2/24, NAT via $uplink"
