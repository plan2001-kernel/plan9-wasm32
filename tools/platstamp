#!/bin/bash
# Stamp a built platform.js with the full SHA-256 of its unstamped source.
# Replace ONLY the declaration, not placeholder strings in the code/comments.
#   tools/platstamp SRC DST
set -e
grep -qx "const PLATHASH = '@PLATHASH@';" "$1" || { echo 'platstamp: unstamped declaration missing' >&2; exit 1; }
h=$(sha256sum "$1")
h=${h%% *}
sed "s|^const PLATHASH = '@PLATHASH@';$|const PLATHASH = '$h';|" "$1" >"$2"
