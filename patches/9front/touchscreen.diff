+	Mouse	m;		/* first: genmenuhit's Mouse* */
+	Mousectl	*mc;
+	int	but;
+	int	phase;		/* 0 waiting for the selecting tap, 1 held, 2 released */
+	int	touched;	/* the selecting tap came from a finger */
+};
