+/*
+ * Is p in the empty margin left or right of the text on its line?
+ * A touch double click there must not stretch into a word on the
+ * line: the line's shell prompt is not part of its body text.
+ */
+static int
+inmargin(Window *w, Point p)
+{
+	Point pt, pe;
+	ulong a, b;
+
+	if(w->nr == 0)
+		return 1;
+	/* the first and last characters of the visual line at p */
+	a = frcharofpt(w, Pt(w->Frame.r.min.x, p.y));
+	b = frcharofpt(w, Pt(w->Frame.r.max.x, p.y));
+	pt = frptofchar(w, a);
+	if(p.y < pt.y || p.y >= pt.y + w->font->height)
+		return 1;	/* above or below the text */
+	pe = frptofchar(w, b);
+	if(pe.y > pt.y){
+		/* b is on the next line: a newline or a wrapped line */
+		if(b > 0 && w->org+b-1 < w->nr && w->r[w->org+b-1] == '\n')
+			pe = frptofchar(w, b-1);	/* the newline: the line's end */
+		else
+			pe.x = w->Frame.r.max.x;	/* the wrapped line's right edge */
+	}
+	return p.x < pt.x || p.x >= pe.x;
+}
+
+/*
+ * Is the click on a blank (space or tab) between words?  The prompt's
+ * trailing space is visually empty, so a touch double click there is
+ * not a word selection either.
+ */
+static int
+onblank(Window *w, Point p, ulong q)
+{
+	Point pt, pe;
+	Rune r;
+
+	if(w->nr == 0)
+		return 1;
+	if(q > w->nr)
+		q = w->nr;
+	if(q == w->nr)
+		q = w->nr-1;
+	pt = frptofchar(w, q);
+	if(p.y < pt.y)
+		return 1;	/* after the line above */
+	if(p.y >= pt.y + w->font->height)
+		return 0;	/* another line */
+	if(p.x < pt.x){
+		if(q == 0)
+			return 0;	/* the left margin (inmargin) */
+		q--;
+		pt = frptofchar(w, q);
+		pe = frptofchar(w, q+1);
+	}else
+		pe = frptofchar(w, q+1);
+	if(p.x < pt.x || p.x >= pe.x)
+		return 0;
+	r = w->r[w->org+q];
+	if(r == '\n')
+		return 1;
+	return isspace(r);
+}
+
+static int
+notword(Window *w, Point p, ulong q)
+{
+	return inmargin(w, p) || onblank(w, p, q);
+}
